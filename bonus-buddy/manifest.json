{
  "manifest_version": 3,
  "name": "Bonus Buddy",
  "version": "2.3.0",
  "description": "Automatically claims Twitch channel point bonuses and tracks your watch time",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["*://*.twitch.tv/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://*.twitch.tv/*"],
      "js": ["bridge.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon-gray.png"
  },
  "icons": {
    "48": "icon.png"
  }
}
