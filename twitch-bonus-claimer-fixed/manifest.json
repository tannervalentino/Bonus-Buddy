{
  "manifest_version": 3,
  "name": "Twitch Bonus Claimer",
  "version": "1.5",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["*://*.twitch.tv/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://*.twitch.tv/*"],
      "js": ["bridge.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
